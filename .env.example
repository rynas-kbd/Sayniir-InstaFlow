# =============================================
# Supabase
# =============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# Meta / Facebook App
# =============================================

# Instagram et Messenger peuvent utiliser deux apps Meta distinctes.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_MESSENGER_APP_ID=
META_MESSENGER_APP_SECRET=

# WhatsApp Embedded Signup (OAuth par popup, pas un redirect classique).
# Nécessite d'avoir créé une Configuration WhatsApp dans le Meta App Dashboard
# (WhatsApp > Configuration) pour obtenir META_WHATSAPP_CONFIG_ID.
NEXT_PUBLIC_META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_CONFIG_ID=

# Utilisée pour la vérification de signature des webhooks WhatsApp.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Secret token you choose freely — generate a real random value per
# environment, do not reuse the same one across dev/staging/prod.
META_WEBHOOK_VERIFY_TOKEN=
META_MESSENGER_VERIFY_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

# =============================================
# App
# =============================================
NEXT_PUBLIC_APP_URL=

# Clé secrète pour appeler les crons depuis Vercel
CRON_SECRET=

# =============================================
# AI providers — customer-facing bot (lib/agent/*)
# =============================================

# OpenRouter is the bot's platform default (falls back to Groq and Gemini if unset).
# Only applies to accounts whose agent_settings.ai_provider hasn't been explicitly set
# (new accounts, or existing ones changed via the UI).
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# OpenRouter can also use multiple platform keys for rotation if needed.
OPENROUTER_API_KEYS=

# =============================================
# AI providers — product copilot (lib/ai/*)
# =============================================

# Groq is the copilot's platform default. Accepts one or several keys, comma-separated —
# a random key is drawn per request to spread load/rate limits (see lib/ai/provider.ts).
# Distinct from GROQ_API_KEY above (customer bot) — different system, different key pool.
GROQ_API_KEYS=

# The 5 other copilot providers (Anthropic, OpenAI, OpenRouter, DeepSeek, Gemini) are BYOK-only —
# each user supplies and encrypts their own key via /settings, no platform key needed for them.

# =============================================
# RapidAPI — Instagram post→product resolution (Vérification de disponibilité)
# =============================================

# Used only to resolve a shared post's caption when a customer forwards a
# post/reel in DM and it isn't already cached in product_posts (see
# lib/integrations/rapidapi/instagram.ts). Leave unset to disable this
# specific lookup — the availability check still works from cached links
# and from plain-text product matching, it just can't resolve a brand-new
# shared post until one is manually linked from the product page.
RAPIDAPI_KEY=
# Defaults to instagram-scraper-api2.p.rapidapi.com if unset.
RAPIDAPI_INSTAGRAM_HOST=

# =============================================
# Chargily Pay v2 — abonnements Manychats (EDAHABIA/CIB, DZD)
# https://dev.chargily.com/pay-v2/introduction
# =============================================

# 'test' (par défaut) ou 'live'. Détermine l'URL d'API utilisée par
# lib/integrations/chargily/client.ts.
CHARGILY_MODE=test

# Clé secrète Chargily (test_sk_... ou live_sk_...). Sert AUSSI à vérifier
# la signature des webhooks (app/api/webhooks/chargily/route.ts) — Chargily
# n'a pas de secret de webhook distinct.
CHARGILY_SECRET_KEY=

# NEXT_PUBLIC_APP_URL doit être une URL publique en HTTPS pour que Chargily
# puisse joindre /api/webhooks/chargily — impossible d'atteindre localhost
# en développement, utiliser ngrok ou équivalent et pointer cette variable
# vers l'URL du tunnel.

# =============================================
# Encryption (tokens & AI keys at rest)
# =============================================
SETTINGS_ENCRYPTION_KEY=




